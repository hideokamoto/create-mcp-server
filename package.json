{
  "name": "create-mcp-tools",
  "version": "1.0.1",
  "description": "CLI tool to create new MCP servers",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "scaffolding"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/create-mcp-server.git"
  },
  "homepage": "https://github.com/hideokamoto/create-mcp-server",
  "bugs": "https://github.com/hideokamoto/create-mcp-server/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "create-mcp-tools": "build/index.js"
  },
  "files": [
    "build",
    "template"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "echo \"No tests specified\" && exit 0",
    "release": "np"
  },
  "np": {
    "yarn": false,
    "tests": false,
    "cleanup": true,
    "branch": "main"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ejs": "^3.1.9",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.0",
    "np": "^10.2.0",
    "shx": "^0.3.4",
    "typescript": "^5.7.2"
  }
}
